// Inspired by Catnap
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "$HOME/.config/fastfetch/images/ArchLogo.png",
    "color": {
      "1": "#F5E0DC",
      "2": "#F2CDCD",
      "3": "#F5C2E7",
      "4": "#FAB387",
      "5": "#F9E2AF",
      "6": "#A6E3A1",
      "7": "#94E2D5",
      "8": "#89DCEB",
      "9": "#74C7EC",
    },
    "width": 50,
    "height": 20,
    "padding": {
      "top": 2,
      "right": 5,
      "left": 0,
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    {
      "key": "{#38}╭────────────────╮",
      "type": "custom",
    },
    {
      "key": "{#38}│ {#34} User    {#keys}     {#38}│",
      "type": "title",
      "format": "{#31}{user-name}",
    },
    {
      "key": "{#38}├────────────────┤",
      "type": "custom",
    },
    {
      "key": "{#38}│ {#34}󰇅 Hostname   {#keys}  {#38}│",
      "type": "title",
    },
    {
      "key": "{#38}│ {#34}󰅐 Uptime  {#keys}     {#38}│",
      "type": "uptime",
    },
    {
      "type": "command",
      "keyIcon": "",
      "key": "{#38}│ {#34}{icon} OS Age  {#keys}     {#38}│",
      "text": "~/.config/bin/utils/sysage.sh",
    },
    {
      "key": "{#38}│ {#34}{icon} Distro  {#keys}     {#38}│",
      "type": "os",
    },
    {
      "key": "{#38}│ {#34} Kernel  {#keys}     {#38}│",
      "type": "kernel",
    },
    {
      "key": "{#38}├────────────────┤",
      "type": "custom",
    },
    {
      "key": "{#38}│ {#32} Terminal   {#keys}  {#38}│",
      "type": "terminal",
    },
    {
      "key": "{#38}│ {#32} Shell   {#keys}     {#38}│",
      "type": "shell",
    },
    {
      "key": "{#38}│ {#32} Session   {#keys}   {#38}│",
      "type": "wm",
    },
    {
      "key": "{#38}│ {#32} System Theme {#keys}{#38}│",
      "type": "command",
      "text": "~/.config/bin/helper/getSystemTheme.sh",
    },
    {
      "key": "{#38}├────────────────┤",
      "type": "custom",
    },
    {
      "key": "{#38}│ {#35} Display  {#keys}    {#38}│",
      "type": "display",
      "compactType": "original-with-refresh-rate",
    },
    {
      "key": "{#38}│ {#35}󰍛 CPU     {#keys}     {#38}│",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      "key": "{#38}│{#35} 󰚗 Mainboard{#keys}    {#38}│",
      "type": "board",
    },
    {
      "key": "{#38}│ {#35}󰍛 GPU     {#keys}     {#38}│",
      "type": "gpu",
    },
    {
      "key": "{#38}│ {#35}󰍛 G-Driver   {#keys}  {#38}│",
      "type": "gpu",
      "format": "{driver}",
    },
    {
      "key": "{#38}│ {#35} Memory  {#keys}     {#38}│",
      "type": "memory",
    },
    {
      "key": "{#38}│ {#35}󰓡 Swap  {#keys}       {#38}│",
      "type": "swap",
    },
    {
      "key": "{#38}├────────────────┤",
      "type": "custom",
    },
    {
      "key": "{#38}│ {#35}󰉉 Main-Disk  {#keys}  {#38}│",
      "type": "disk",
      "folders": "/home",
    },
    {
      "key": "{#38}│ {#35}󰉉 Games-Disk {#keys}  {#38}│",
      "type": "disk",
      "folders": "/mnt/games",
    },
    {
      "key": "{#38}│ {#35}󰉉 Games-Disk 2 {#keys}{#38}│",
      "type": "disk",
      "folders": "/mnt/games2",
    },
    {
      "key": "{#38}│ {#35}󰉉 NAS        {#keys}  {#38}│",
      "type": "disk",
      "folders": "/mnt/trypezz-nas",
    },
    {
      "key": "{#38}├────────────────┤",
      "type": "custom",
    },
    {
      "key": "{#38}│ {#39} Colors  {#keys}     {#38}│",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "{#38}╰────────────────╯",
      "type": "custom",
    },
  ],
}
